<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CheckoutActivity">

    <!-- ScrollView chứa nội dung -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/bg_light"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnConfirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Phần địa chỉ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/btnArrowBack"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/arrowleft"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvSavedAddresses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chọn địa chỉ giao hàng"
                    app:fontFamily="@font/poppins_bold"
                    style="@style/TitleTextStyle" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:padding="8dp"
                android:clipToPadding="false" />

            <!-- Thêm địa chỉ -->
            <LinearLayout
                android:id="@+id/btnAddAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="12dp"
                style="@style/CardStyle"
                android:layout_marginBottom="16dp">
                <ImageView
                    android:id="@+id/iconAddAddress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/icon_new_address"
                    android:tint="@color/black" />
                <TextView
                    android:id="@+id/tvAddNewAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thêm địa chỉ mới"
                    app:fontFamily="@font/poppins_bold"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Phương thức thanh toán -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_debitcard"
                    android:tint="@color/black"
                    android:layout_marginEnd="8dp" />
                <TextView
                    android:id="@+id/tvPaymentMethod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phương thức thanh toán"
                    app:fontFamily="@font/poppins_bold"
                    style="@style/TitleTextStyle" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/rgPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">
                <RadioButton
                    android:id="@+id/rbCash"
                    style="@style/RadioButtonStyle"
                    android:drawableLeft="@drawable/ic_cash"
                    android:drawablePadding="4dp"
                    android:paddingStart="8dp"
                    android:text="Thanh toán khi nhận hàng (COD)" />
                <RadioButton
                    android:id="@+id/rbCard"
                    style="@style/RadioButtonStyle"
                    android:drawableLeft="@drawable/ic_payment"
                    android:drawablePadding="4dp"
                    android:paddingStart="8dp"
                    android:text="Thanh toán qua thẻ" />
                <RadioButton
                    android:id="@+id/rbBankTransfer"
                    android:drawableLeft="@drawable/ic_bank_transfer"
                    android:drawablePadding="4dp"
                    android:paddingStart="8dp"
                    style="@style/RadioButtonStyle"
                    android:text="Chuyển khoản ngân hàng" />
            </RadioGroup>

            <!-- Tổng số tiền -->
            <TextView
                android:id="@+id/textTotalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tổng số tiền: 0 VND"
                android:textStyle="bold"
                app:fontFamily="@font/poppins_bold"
                android:layout_marginBottom="24dp" />

            <!-- Ghi chú -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_list"
                    android:tint="@color/black"
                    android:layout_marginEnd="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ghi chú"
                    app:fontFamily="@font/poppins_bold"
                    style="@style/TitleTextStyle" />
            </LinearLayout>

            <EditText
                android:id="@+id/textNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập ghi chú"
                android:padding="12dp"
                android:textColor="@color/black"
                android:textSize="16sp"
                app:fontFamily="@font/poppins_regular"
                android:layout_marginBottom="24dp"/>

            <!-- Sản phẩm mua -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewCheckout"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"
                android:padding="8dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Nút Đặt Hàng -->
    <Button
        android:id="@+id/btnConfirm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/addtocartshape"
        app:backgroundTint="@null"
        app:fontFamily="@font/poppins_bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="ĐẶT HÀNG" />
</androidx.constraintlayout.widget.ConstraintLayout>
