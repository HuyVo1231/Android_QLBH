<resources>
    <!-- Bold and Blue Text for Titles -->
    <style name="CustomAvatarShape" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item> 
    </style>


    <style name="TitleText">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Gray Text for Values -->
    <style name="ValueText">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Gray Divider -->
    <style name="DividerStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@android:color/darker_gray</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

        <!-- Style for TextViews -->
        <style name="BaseTextViewStyle">
            <item name="android:textSize">16sp</item>
            <item name="android:textColor">@color/black</item>
        </style>

        <style name="TitleTextStyle" parent="BaseTextViewStyle">
            <item name="android:textSize">20sp</item>
            <item name="android:textStyle">bold</item>
            <item name="android:textColor">@color/black</item>
        </style>

        <!-- Style for Buttons -->
        <style name="PrimaryButtonStyle">
            <item name="android:textColor">@android:color/white</item>
            <item name="android:padding">12dp</item>
            <item name="android:elevation">8dp</item>
            <item name="android:layout_marginTop">16dp</item>
        </style>

        <!-- Style for Card Elements -->
        <style name="CardStyle">
            <item name="android:background">@drawable/card_background</item>
            <item name="android:orientation">horizontal</item>
            <item name="android:padding">12dp</item>
            <item name="android:elevation">6dp</item>
        </style>

        <!-- Style for RadioButtons -->
        <style name="RadioButtonStyle">
            <item name="android:textColor">@color/purple_500</item>
            <item name="android:buttonTint">@color/purple_500</item>
            <item name="android:textSize">16sp</item>
            <item name="android:fontFamily">@font/poppins_bold</item>
        </style>

        <!-- Style for LinearLayouts with padding -->
        <style name="PaddingLinearLayoutStyle">
            <item name="android:padding">16dp</item>
        </style>



</resources>
